#bookaudio .ba-tr:hover{background:#221D17;color:#F2EEE7}
#bookaudio .ba-tr[aria-current="true"]{background:#2C1E14;color:#F0A079}
#bookaudio .ba-n{flex:none;width:18px;color:#7A7468;font-variant-numeric:tabular-nums}
#bookaudio .ba-nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#bookaudio .ba-d{flex:none;color:#7A7468;font-variant-numeric:tabular-nums}
@media (max-width:560px){#bookaudio{left:12px;right:12px;bottom:12px;max-width:none}}
@media print{#bookaudio{display:none!important}}</style>
<aside id="bookaudio" data-open="0" aria-label="Listen to this book">
  <div class="ba-card">
    <button class="ba-head" type="button" aria-expanded="false">
      <span class="ba-ico" aria-hidden="true">&#9654;</span>
      <span class="ba-t"><b>Listen &middot; 10 tracks, 30 min</b><span></span></span>
      <span class="ba-chev" aria-hidden="true">&#9650;</span>
    </button>
    <div class="ba-body">
      <audio controls preload="none"></audio>
      <ol>
        <li><button class="ba-tr" type="button" data-src="audio/00-what-this-is-and-how-to-disbelieve-it.mp3"><span class="ba-n">1</span><span class="ba-nm">What this is and how to disbelieve it</span><span class="ba-d">1:58</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/01-a-slogan-with-fingerprints-on-it.mp3"><span class="ba-n">2</span><span class="ba-nm">A slogan with fingerprints on it</span><span class="ba-d">3:07</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/02-cost-is-understood-not-settled.mp3"><span class="ba-n">3</span><span class="ba-nm">Cost is understood not settled</span><span class="ba-d">3:34</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/03-how-much-speed-is-on-the-table.mp3"><span class="ba-n">4</span><span class="ba-nm">How much speed is on the table</span><span class="ba-d">2:25</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/04-the-half-life.mp3"><span class="ba-n">5</span><span class="ba-nm">The half life</span><span class="ba-d">3:45</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/05-what-speed-actually-buys.mp3"><span class="ba-n">6</span><span class="ba-nm">What speed actually buys</span><span class="ba-d">2:58</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/06-the-experiment-nobody-had-run.mp3"><span class="ba-n">7</span><span class="ba-nm">The experiment nobody had run</span><span class="ba-d">2:40</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/07-already-governed-just-not-by-you.mp3"><span class="ba-n">8</span><span class="ba-nm">Already governed just not by you</span><span class="ba-d">2:27</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/08-what-to-do-on-monday.mp3"><span class="ba-n">9</span><span class="ba-nm">What to do on monday</span><span class="ba-d">3:08</span></button></li>
        <li><button class="ba-tr" type="button" data-src="audio/09-appendix-a-method-and-what-would-break-i.mp3"><span class="ba-n">10</span><span class="ba-nm">Appendix a method and what would break i</span><span class="ba-d">4:15</span></button></li>
      </ol>
    </div>
  </div>
</aside>
<script>(function(){
  var el=document.getElementById('bookaudio'); if(!el) return;
  var a=el.querySelector('audio'), head=el.querySelector('.ba-head'),
      sub=el.querySelector('.ba-t span'), rows=[].slice.call(el.querySelectorAll('.ba-tr'));
  var cur=-1;
  head.addEventListener('click',function(){
    el.setAttribute('data-open', el.getAttribute('data-open')==='1'?'0':'1');
  });
  function select(i,play){
    if(i<0||i>=rows.length) return;
    cur=i;
    rows.forEach(function(r,j){ r.setAttribute('aria-current', j===i?'true':'false'); });
    a.src=rows[i].getAttribute('data-src');
    sub.textContent=rows[i].querySelector('.ba-nm').textContent;
    if(play) a.play().catch(function(){});
  }
  rows.forEach(function(r,i){ r.addEventListener('click',function(){ select(i,true); }); });
  a.addEventListener('ended',function(){ if(cur+1<rows.length) select(cur+1,true); });
  select(0,false);
})();</script>
<!-- BOOK-AUDIO:END -->
